---
import { buscarFoto } from '../lib/medios';
import Anillos from './Anillos.astro';

interface Props {
  nombre: string;
  alt: string;
  class?: string;
  sizes?: string;
  prioridad?: boolean;
  /** Foto de fondo bajo el texto: se carga enseguida pero sin quitarle prioridad al título */
  fondo?: boolean;
  [attr: string]: unknown;
}
const { nombre, alt, class: clase = '', sizes = '(max-width: 800px) 100vw, 50vw', prioridad = false, fondo = false, ...resto } = Astro.props;
const fuente = buscarFoto(nombre);
---
{fuente ? (
  <div class:list={['foto', clase]} {...resto}>
    <img
      src={fuente.src}
      srcset={fuente.srcset}
      sizes={fuente.srcset ? sizes : undefined}
      alt={alt}
      loading={prioridad || fondo ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : fondo ? 'low' : 'auto'}
      decoding="async"
    />
  </div>
) : (
  <div class:list={['foto', 'foto--ph', clase]} role="img" aria-label={alt} data-falta={nombre} {...resto}>
    <div class="foto__ph" aria-hidden="true">
      <Anillos />
      {import.meta.env.DEV && <span>{nombre}.jpg</span>}
    </div>
  </div>
)}
