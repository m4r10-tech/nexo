---
/**
 * Mapa con carga bajo demanda: Google Maps solo se carga cuando el usuario lo pide.
 * Así la web no instala cookies de terceros sin consentimiento y carga más rápido.
 */
import { CONTACTO, mapsEmbedUrl, mapsComoLlegarUrl } from '../data/restaurante';
import Anillos from './Anillos.astro';
const { calle, cp, ciudad } = CONTACTO.direccion;
---
<div class="mapa" data-mapa data-src={mapsEmbedUrl}>
  <div class="mapa__fachada">
    <div class="mapa__grid" aria-hidden="true"></div>
    <div class="mapa__pin" aria-hidden="true"><Anillos /></div>
    <div class="mapa__info">
      <p class="mapa__dir">{calle}<br /><span>{cp} {ciudad}</span></p>
      <div class="btn-row">
        <button type="button" class="btn btn--small" data-mapa-cargar data-cursor="Mapa">Ver mapa</button>
        <a class="btn btn--small btn--ghost" href={mapsComoLlegarUrl} target="_blank" rel="noopener" data-cursor="Ir">Cómo llegar ↗</a>
      </div>
      <p class="mapa__aviso">Al ver el mapa se cargará contenido de Google Maps.</p>
    </div>
  </div>
</div>

<style>
  .mapa { position: relative; height: clamp(360px, 48vw, 540px); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: var(--bg-3); }
  .mapa__fachada { position: absolute; inset: 0; display: grid; place-items: center; text-align: center; padding: 24px; }
  .mapa__grid {
    position: absolute; inset: 0; opacity: .5;
    background:
      radial-gradient(circle at 50% 42%, rgba(200,149,92,.25), transparent 45%),
      repeating-linear-gradient(0deg, transparent 0 46px, rgba(243,236,226,.05) 46px 47px),
      repeating-linear-gradient(90deg, transparent 0 46px, rgba(243,236,226,.05) 46px 47px),
      linear-gradient(115deg, transparent 48%, rgba(243,236,226,.08) 48% 50%, transparent 50%),
      linear-gradient(25deg, transparent 60%, rgba(243,236,226,.06) 60% 61.5%, transparent 61.5%);
  }
  .mapa__pin { position: relative; width: 70px; margin: 0 auto 18px; animation: flotar 3s ease-in-out infinite; }
  .mapa__info { position: relative; }
  .mapa__dir { font-family: var(--serif); font-size: clamp(26px, 3vw, 36px); line-height: 1.15; margin-bottom: 22px; }
  .mapa__dir span { font-size: .6em; color: var(--muted); font-style: italic; }
  .mapa__info .btn-row { justify-content: center; }
  .mapa__aviso { margin-top: 16px; font-size: 12px; color: var(--muted); }
  .mapa :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  @keyframes flotar { 50% { transform: translateY(-8px); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mapa]').forEach(mapa => {
    mapa.querySelector('[data-mapa-cargar]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = mapa.dataset.src!;
      iframe.title = 'Mapa de ubicación del restaurante';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      mapa.querySelector('.mapa__fachada')?.remove();
      mapa.append(iframe);
    });
  });
</script>
