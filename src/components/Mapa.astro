---
/**
 * Mapa de Google con la ubicación del local. Se ve directamente y, al pincharlo,
 * abre la ficha del restaurante en Google Maps (nueva pestaña).
 * El iframe no recibe clics: todo el mapa es un enlace.
 */
import { CONTACTO, SITIO, mapsEmbedUrl, mapsLugarUrl } from '../data/restaurante';
const { calle, cp, ciudad } = CONTACTO.direccion;
---
<a class="mapa" href={mapsLugarUrl} target="_blank" rel="noopener" data-mapa
   aria-label={`Abrir ${SITIO.nombre} (${calle}, ${cp} ${ciudad}) en Google Maps`}>
  <iframe src={mapsEmbedUrl} title={`Mapa: ${SITIO.nombre}, ${calle}, ${ciudad}`} loading="lazy"
          referrerpolicy="no-referrer-when-downgrade" tabindex="-1" aria-hidden="true"></iframe>
  <span class="mapa__etiqueta">
    <span class="mapa__dir">{calle} · {cp} {ciudad}</span>
    <span class="mapa__abrir">Abrir en Google Maps ↗</span>
  </span>
</a>

<style>
  .mapa { position: relative; display: block; height: clamp(360px, 48vw, 540px); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: var(--bg-3); }
  .mapa iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; pointer-events: none; filter: saturate(.85); transition: filter .5s var(--ease); }
  .mapa:hover iframe, .mapa:focus-visible iframe { filter: none; }
  .mapa__etiqueta {
    position: absolute; left: 14px; right: 14px; bottom: 14px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 16px;
    padding: 14px 18px; border-radius: var(--radius); background: rgba(20,17,15,.88); backdrop-filter: blur(6px); color: var(--ink); font-size: 14px;
  }
  .mapa__dir { font-family: var(--serif); font-size: 19px; }
  .mapa__abrir { color: var(--accent); transition: transform .4s var(--ease); }
  .mapa:hover .mapa__abrir, .mapa:focus-visible .mapa__abrir { transform: translateX(3px); }
</style>
