---
/** Monograma de los dos anillos entrelazados (el «nexo»). */
interface Props { class?: string }
const { class: clase } = Astro.props;
---
<svg class={clase} viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" style="color: var(--accent)">
  <circle cx="38" cy="30" r="24" /><circle cx="62" cy="30" r="24" />
</svg>
