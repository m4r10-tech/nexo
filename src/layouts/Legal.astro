---
import Base from './Base.astro';
import { LEGAL } from '../data/restaurante';
interface Props { titulo: string; descripcion: string }
const { titulo, descripcion } = Astro.props;
const fecha = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' }).format(new Date(`${LEGAL.actualizado}T12:00:00Z`));
---
<Base titulo={titulo} descripcion={descripcion}>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Información legal</p>
      <h1 class="title">{titulo}</h1>
      <p class="muted">Última actualización: {fecha}</p>
    </div>
  </header>
  <article class="container legal">
    <slot />
  </article>
</Base>
<style>
  .legal { max-width: 820px; padding-block: clamp(60px, 8vw, 110px); }
  .legal :global(h2) { font-family: var(--serif); font-weight: 400; font-size: 32px; margin: 44px 0 14px; }
  .legal :global(h2:first-child) { margin-top: 0; }
  .legal :global(p), .legal :global(li) { color: var(--muted); margin-bottom: 12px; }
  .legal :global(ul) { padding-left: 20px; }
  .legal :global(strong) { color: var(--ink); font-weight: 500; }
  .legal :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .legal :global(table) { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14px; }
  .legal :global(th), .legal :global(td) { text-align: left; padding: 12px; border-bottom: 1px solid var(--line); color: var(--muted); vertical-align: top; }
  .legal :global(th) { color: var(--ink); font-weight: 500; }
  @media (max-width: 640px) {
    .legal :global(thead) { display: none; }
    .legal :global(tr) { display: block; padding: 10px 0; border-bottom: 1px solid var(--line); }
    .legal :global(td) { display: grid; grid-template-columns: 110px 1fr; gap: 12px; border: 0; padding: 6px 0; }
    .legal :global(td::before) { content: attr(data-l); color: var(--ink); font-weight: 500; }
  }
</style>
