---
import '../styles/global.css';
import { SITIO, CONTACTO, HORARIO, ANALITICA } from '../data/restaurante';
import { horaLegible } from '../lib/horario';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  noindex?: boolean;
  /** Datos estructurados extra para esta página (schema.org) */
  schema?: Record<string, unknown>;
  /** Pantalla de carga (solo portada, una vez por visita) */
  intro?: boolean;
  sinCabecera?: boolean;
}
const { titulo, descripcion = SITIO.descripcion, imagen = '/og.jpg', noindex = false, schema, intro = false, sinCabecera = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITIO.nombre}` : `${SITIO.nombre} · Restaurante en Toledo`;
const canonica = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
const { calle, cp, ciudad, region, pais } = CONTACTO.direccion;

const DIAS_EN = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const restaurante = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${SITIO.url}/#restaurante`,
  name: SITIO.nombre,
  description: SITIO.descripcion,
  url: SITIO.url,
  image: imagenAbs.href,
  logo: new URL('/logo.svg', Astro.site).href,
  telephone: CONTACTO.telefono,
  ...(CONTACTO.email && { email: CONTACTO.email }),
  servesCuisine: ['Mediterránea', 'Española'],
  priceRange: '€€',
  acceptsReservations: true,
  hasMenu: `${SITIO.url}/carta`,
  address: { '@type': 'PostalAddress', streetAddress: calle, postalCode: cp, addressLocality: ciudad, addressRegion: region, addressCountry: pais },
  ...(CONTACTO.geo && { geo: { '@type': 'GeoCoordinates', latitude: CONTACTO.geo.lat, longitude: CONTACTO.geo.lng } }),
  sameAs: [CONTACTO.instagram],
  openingHoursSpecification: Object.entries(HORARIO).flatMap(([d, turnos]) =>
    turnos.map(t => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: DIAS_EN[Number(d)],
      opens: t.abre,
      closes: t.cierra === '24:00' ? '23:59' : horaLegible(t.cierra),
    })),
  ),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {(noindex || import.meta.env.PUBLIC_DEMO === 'true') && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#14110f" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(restaurante)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    {intro && (
      <div class="loader" data-loader aria-hidden="true">
        <svg class="loader__anillos" viewBox="0 0 100 60" fill="none" stroke="#c8955c" stroke-width="1.2">
          <circle cx="38" cy="30" r="24" pathLength="1" /><circle cx="62" cy="30" r="24" pathLength="1" />
        </svg>
        <p class="loader__nombre">NEXO <em>by Martina</em></p>
      </div>
      <script is:inline>
        try { if (sessionStorage.getItem('nexo-intro')) document.documentElement.classList.add('sin-intro'); } catch (e) {}
      </script>
    )}

    <div class="grain" aria-hidden="true"></div>

    {!sinCabecera && <Header />}
    <main id="contenido">
      <slot />
    </main>
    {!sinCabecera && <Footer />}

    <script>
      import '../scripts/interacciones';
    </script>
    {ANALITICA.cloudflareToken && import.meta.env.PUBLIC_DEMO !== 'true' && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALITICA.cloudflareToken })}></script>
    )}
  </body>
</html>

<style is:global>
  .loader {
    position: fixed; inset: 0; z-index: 100; display: grid; place-content: center; justify-items: center; gap: 22px;
    background: var(--bg); clip-path: inset(0 0 0 0); transition: clip-path 1.1s var(--ease) .15s;
  }
  .loader__anillos { width: 120px; }
  .loader__anillos circle { stroke-dasharray: 1; stroke-dashoffset: 1; animation: trazo 1.3s var(--ease) forwards; }
  .loader__anillos circle + circle { animation-delay: .25s; }
  .loader__nombre { font-family: var(--serif); font-size: 26px; letter-spacing: .3em; opacity: 0; animation: aparecer .8s var(--ease) .7s forwards; }
  .loader__nombre em { letter-spacing: .02em; }
  @keyframes trazo { to { stroke-dashoffset: 0; } }
  @keyframes aparecer { to { opacity: 1; } }
  .is-ready .loader { clip-path: inset(0 0 100% 0); pointer-events: none; }
  .sin-intro .loader { display: none; }

</style>
