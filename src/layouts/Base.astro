---
import '../styles/global.css';
import { SITIO, CONTACTO, HORARIO, ANALITICA } from '../data/restaurante';
import { horaLegible } from '../lib/horario';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Esqueleto from '../components/Esqueleto.astro';
// Fuentes que se ven nada más cargar: se precargan para que el título aparezca antes
import fuenteTitulo from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import fuenteTexto from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  noindex?: boolean;
  /** Datos estructurados extra para esta página (schema.org) */
  schema?: Record<string, unknown>;
  /** Esqueleto de carga con la forma de la portada (si no, el de página interior) */
  intro?: boolean;
  /** Imagen principal que se precarga (LCP) */
  precarga?: { src: string; srcset?: string; sizes?: string };
  sinCabecera?: boolean;
}
const { titulo, descripcion = SITIO.descripcion, imagen = '/og.jpg', noindex = false, schema, intro = false, sinCabecera = false, precarga } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITIO.nombre}` : `${SITIO.nombre} · Restaurante en Toledo`;
const canonica = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
const { calle, cp, ciudad, region, pais } = CONTACTO.direccion;

const DIAS_EN = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const restaurante = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${SITIO.url}/#restaurante`,
  name: SITIO.nombre,
  description: SITIO.descripcion,
  url: SITIO.url,
  image: imagenAbs.href,
  logo: new URL('/logo.svg', Astro.site).href,
  telephone: CONTACTO.telefono,
  ...(CONTACTO.email && { email: CONTACTO.email }),
  servesCuisine: ['Mediterránea', 'Española'],
  priceRange: '€€',
  acceptsReservations: true,
  hasMenu: `${SITIO.url}/carta`,
  address: { '@type': 'PostalAddress', streetAddress: calle, postalCode: cp, addressLocality: ciudad, addressRegion: region, addressCountry: pais },
  ...(CONTACTO.geo && { geo: { '@type': 'GeoCoordinates', latitude: CONTACTO.geo.lat, longitude: CONTACTO.geo.lng } }),
  sameAs: [CONTACTO.instagram],
  openingHoursSpecification: Object.entries(HORARIO).flatMap(([d, turnos]) =>
    turnos.map(t => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: DIAS_EN[Number(d)],
      opens: t.abre,
      closes: t.cierra === '24:00' ? '23:59' : horaLegible(t.cierra),
    })),
  ),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {(noindex || import.meta.env.PUBLIC_DEMO === 'true') && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#14110f" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href={fuenteTitulo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    {precarga && <link rel="preload" as="image" href={precarga.src} imagesrcset={precarga.srcset} imagesizes={precarga.sizes} fetchpriority="high" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(restaurante)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    {!sinCabecera && <Esqueleto variante={intro ? 'portada' : 'pagina'} />}
    <noscript><style>.esqueleto { display: none; }</style></noscript>

    <div class="grain" aria-hidden="true"></div>

    {!sinCabecera && <Header />}
    <main id="contenido">
      <slot />
    </main>
    {!sinCabecera && <Footer />}

    <script>
      import '../scripts/interacciones';
    </script>
    {ANALITICA.cloudflareToken && import.meta.env.PUBLIC_DEMO !== 'true' && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALITICA.cloudflareToken })}></script>
    )}
  </body>
</html>

<style is:global>

</style>
